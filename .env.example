# Plantilla de variables de entorno. Copia este fichero a .env.local y rellena
# los valores. NUNCA pongas valores reales aqui: este fichero si se versiona.
#
# Los valores de produccion estan en Vercel (proyecto club-ferrari-espana,
# equipo simbai): `vercel env pull .env.local` los trae ya rellenos.

# ── Base de datos (Neon / Postgres) ───────────────────────────
# DATABASE_URL es la que usa Prisma. El resto las añade la integracion de Neon.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NO_SSL=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_DATABASE=
PGHOST=
PGHOST_UNPOOLED=
PGUSER=
PGPASSWORD=
PGDATABASE=
NEON_PROJECT_ID=
NEON_AUTH_BASE_URL=
VITE_NEON_AUTH_URL=

# ── Autenticacion (NextAuth + Resend) ─────────────────────────
AUTH_SECRET=
AUTH_RESEND_KEY=
AUTH_EMAIL_FROM=

# ── Pagos (Stripe) ────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SOCIO_BASE=
STRIPE_PRICE_SOCIO_ACTIVO=
STRIPE_PRICE_SOCIO_FAMILIAR=

# ── Sitio ─────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=
CLUB_NOTIFICATION_EMAIL=

# ── Solo para los scripts de prueba de scripts/ ───────────────
TEST_BASE_URL=
